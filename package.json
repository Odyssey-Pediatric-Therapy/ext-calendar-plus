{
  "name": "espocrm-ext-calendar-plus",
  "version": "1.2.0",
  "description": "Calendar Plus: shared calendars, saved views, and team scheduling for EspoCRM.",
  "scripts": {
    "sa": "php site/vendor/bin/phpstan analyse --configuration phpstan.neon",
    "unit-tests": "php site/vendor/bin/phpunit --configuration phpunit.xml",
    "integration-tests": "npm run test:integration",
    "copy": "node build --copy",
    "composer-install": "node build --composer-install",
    "sync": "node build --copy && node build --composer-install && npm run clear-cache",
    "extension": "node build --extension",
    "clear-cache": "php site/clear_cache.php",
    "rebuild": "node build --rebuild",
    "all": "node build --all",
    "prepare-test": "node build --prepare-test",
    "test:client": "node --test tests/client/*.test.js",
    "test": "npm run test:client && npm run unit-tests",
    "test:prepare": "node tests/support/prepare.mjs",
    "test:seed": "php tests/support/seed.php",
    "test:serve": "node tests/support/serve.mjs",
    "test:browsers": "node tests/support/install-browser.mjs",
    "test:integration": "npm run test:prepare && playwright test --project=api",
    "test:e2e": "npm run test:prepare && playwright test --project=chromium --project=mobile",
    "test:system": "npm run test:prepare && playwright test"
  },
  "type": "module",
  "author": "Anthony Andriano",
  "dependencies": {
    "espo-extension-tools": "github:espocrm/extension-tools#0.4.5",
    "fs-extra": "^9.0.0",
    "html2canvas": "1.4.1",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "npm": ">=8",
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  }
}
